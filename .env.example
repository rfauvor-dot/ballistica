# Paid APIs: speech-to-text and text-to-speech (OpenAI), intent (Anthropic).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase project. The anon key is public by design (row-level security is
# the boundary); the JWT secret is only a fallback for legacy HS256 tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Used for exactly one thing: deleting a user's own login on account
# deletion. Without it, DELETE /v2/account returns 503.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Per-user daily cap on paid-API spend, in dollars (default 3.00).
DAILY_BUDGET_USD=
# Optional. Set to "off" to stop writing the per-turn conversation debug log
# (default on). Entries older than 30 days are deleted either way.
CONVERSATION_DEBUG_LOG=
